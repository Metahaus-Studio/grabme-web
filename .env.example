# Public configuration only. Never add credentials or an Admin password here.
# Leave empty until the shared staging API and CORS origin are verified.
NEXT_PUBLIC_PASSENGER_API_URL=
# Requires reviewed backend schema, module registration, privacy and Admin queue.
NEXT_PUBLIC_WEBSITE_INTAKE_ENABLED=false
# Keep previews out of search indexes. Enable only for an approved release.
NEXT_PUBLIC_RELEASE_APPROVED=false
